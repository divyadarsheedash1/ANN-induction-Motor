   "source": [
    "import torch.nn as nn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "5fe0fa96-8339-4261-adb3-cb10f0842d69",
   "metadata": {},
   "outputs": [],
   "source": [
    "class MotorModel_1(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.l1 = nn.Linear(4 , 64)\n",
    "        self.l2 = nn.Linear(64 , 128)\n",
    "        self.l3 = nn.Linear(128 , 64)\n",
    "        self.l4 = nn.Linear(64 , 6)\n",
    "        self.r = nn.ReLU()\n",
    "        self.d = nn.Dropout(0.15)\n",
    "    def forward(self , x):\n",
    "        return self.l4(self.d(self.r(self.l3(self.d(self.r(self.l2(self.d(self.r(self.l1(x))))))))))"
   ]
  },
