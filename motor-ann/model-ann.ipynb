    "import torch\n",
    "from torch import nn\n",
    "\n",
    "class MotorANN(nn.Module):\n",
    "    \n",
    "    def __init__(self):\n",
    "        \n",
    "        super().__init__()\n",
    "        \n",
    "        self.network = nn.Sequential(\n",
    "            \n",
    "            nn.Linear(4, 50),\n",
    "            nn.Sigmoid(),\n",
    "            \n",
    "            nn.Linear(50, 50),\n",
    "            nn.Sigmoid(),\n",
    "            \n",
    "            nn.Linear(50, 6)\n",
    "        )\n",
    "        \n",
    "    def forward(self, x):\n",
    "        \n",
    "        return self.network(x)\n",
    "\n",
    "\n",
    "m4 = MotorANN()"
   ]
